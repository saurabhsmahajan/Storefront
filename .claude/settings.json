{
    "permissions": {
        "deny": [
            "Read(.env)",
            "Read(frontend/.env)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/hooks/format-on-edit.mjs"
                    }
                ]
            }
        ]
    }
}
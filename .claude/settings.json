{
    "permissions": {
        "deny": [
            "Read(.env)",
            "Read(frontend/.env)",
            "Edit(supabase/migrations/**)",
            "Write(supabase/migrations/**)",
            "Bash(cat .env*)",
            "Bash(cat frontend/.env*)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/hooks/format-on-edit.mjs"
                    }
                ]
            }
        ]
    }
}